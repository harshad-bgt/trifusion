# Trifusion Technology LLP — Environment Configuration
# Copy this file to .env and fill in your actual values

# ── Database ────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/trifusion_db?schema=public"

# ── API Server ───────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ── Authentication ───────────────────────────────────────────
# IMPORTANT: Change this to a strong random string in production
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000"

# ── Next.js Frontend ─────────────────────────────────────────
# URL of the Express API, used by Next.js for server-side API calls
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Email Configuration ──────────────────────────────────────
# Option A: Resend (recommended)
RESEND_API_KEY="re_xxxxxxxxxx"

# Option B: SMTP / Nodemailer
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your@email.com"
# SMTP_PASS="your-app-password"

# ── Business Information ─────────────────────────────────────
# [TODO: Fill in real Trifusion contact details]
TRIFUSION_NAME="Trifusion Technology LLP"
TRIFUSION_EMAIL="hello@trifusiontechnology.in"
TRIFUSION_PHONE="+91 XXXXX XXXXX"
TRIFUSION_WHATSAPP="+91 XXXXX XXXXX"
TRIFUSION_ADDRESS="[City], India"
TRIFUSION_FROM_EMAIL="noreply@trifusiontechnology.in"

# ── Admin Credentials (seed) ─────────────────────────────────
# [TODO: Change before production]
ADMIN_EMAIL="admin@trifusiontechnology.in"
ADMIN_PASSWORD="ChangeMe@2024!"
ADMIN_NAME="Trifusion Admin"

# ── Google Sheets Integration ─────────────────────────────────
# Used to store contact form submissions / leads in Google Sheets.
# Server-side ONLY — never expose these to the browser.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private key as a single line with literal \n for newlines:
GOOGLE_SHEETS_PRIVATE_KEY=
